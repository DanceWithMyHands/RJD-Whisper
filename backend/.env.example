# --- Окружение ---
ENVIRONMENT=local
DEBUG=true

# --- База данных ---
# Можно задать DATABASE_URL целиком (async DSN) либо отдельные части ниже.
# DATABASE_URL=postgresql+asyncpg://rzd:rzd_password@localhost:5432/rzd_protocol
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rzd
POSTGRES_PASSWORD=rzd_password
POSTGRES_DB=rzd_protocol

# --- Безопасность (ОБЯЗАТЕЛЬНО заменить в проде) ---
SECRET_KEY=CHANGE_ME_super_secret_key_min_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rzd-recordings
S3_USE_SSL=false

# --- SMTP (если пусто — письма пишутся в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@rzd-protocol.local
SMTP_FROM_NAME=РЖД · Протокол

# --- Провайдеры ---
# ASR_PROVIDER: stub | openai_compatible | nim
#   stub               — демо-транскрипт без реального аудио
#   openai_compatible  — Groq / OpenAI / self-hosted Whisper
#   nim                — Nvidia NIM (концепт прод-развёртывания)
ASR_PROVIDER=stub
LLM_PROVIDER=stub
BOT_PROVIDER=stub

# OpenAI-совместимый ASR (по умолчанию — Groq Whisper). Получить ключ: console.groq.com
ASR_API_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=ru
ASR_TIMEOUT_SEC=300

# Nvidia NIM ASR (для прод-концепции / self-hosted)
NIM_BASE_URL=
NIM_API_KEY=
NIM_MODEL=nvidia/parakeet-ctc-1.1b-asr

# --- Сидирование демо-данными при старте контейнера ---
SEED_ON_START=true

# --- CORS (через запятую) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
